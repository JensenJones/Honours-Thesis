      \field{issn}{0030-4018}
      \field{journaltitle}{Optics Communications}
      \field{month}{10}
      \field{shortjournal}{Optics Communications}
      \field{title}{Mathematical Analysis of Adaptive Step-Size Techniques When Solving the Nonlinear {{Schrödinger}} Equation for Simulating Light-Wave Propagation in Optical Fibers}
