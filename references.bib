@article{garmireStimulatedBrillouinReview2018,
  title = {Stimulated {{Brillouin Review}}: {{Invented}} 50 {{Years Ago}} and {{Applied Today}}},
  shorttitle = {Stimulated {{Brillouin Review}}},
  author = {Garmire, Elsa},
  date = {2018},
  journaltitle = {International Journal of Optics},
  volume = {2018},
  number = {1},
  pages = {2459501},
  issn = {1687-9392},
  doi = {10.1155/2018/2459501},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1155/2018/2459501},
  urldate = {2026-11-08},
  abstract = {Stimulated Brillouin scattering (SBS) is embedded today in a variety of optical systems, such as advanced high-power lasers, sensors, microwave signal processors, scientific instrumentation, and optomechanical systems. Reduction in SBS power requirements involves use of optical fibers, integrated optics, micro-optic devices, and now nano-optics, often in high Q cavities. It has taken fifty years from its earliest invention by conceptual discovery until today for SBS to become a practical and useful technology in a variety of applications. Some of these applications are explained and it is shown how they are tied to particular attributes of SBS: phase conjugation, frequency shifts, low noise, narrow linewidth, frequency combs, optical and microwave signal processing, etc.},
  langid = {english},
  file = {/Users/jensen/Zotero/storage/A98QHAUI/Garmire - 2018 - Stimulated Brillouin Review Invented 50 Years Ago and Applied Today.pdf;/Users/jensen/Zotero/storage/MDATWBKV/2459501.html}
}

@article{huangFiberbasedTechniquesSuppress2023,
  title = {Fiber-Based Techniques to Suppress Stimulated {{Brillouin}} Scattering},
  author = {Huang, Bin and Wang, Jiaqi and Shao, Xiaopeng},
  date = {2023-03},
  journaltitle = {Photonics},
  volume = {10},
  number = {3},
  pages = {282},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2304-6732},
  doi = {10.3390/photonics10030282},
  url = {https://www.mdpi.com/2304-6732/10/3/282},
  urldate = {2026-11-13},
  abstract = {Stimulated Brillouin scattering (SBS) is the major factor that limits the maximum optical fiber output power in narrow linewidth applications, which include important fields such as passive optical networks (PONs), high-power fiber amplifiers, and lasers. Great efforts have been dedicated to suppressing the SBS effect and increasing the maximum optical fiber output power. This paper focuses on key fiber-based techniques to suppress SBS. These techniques take advantages of the properties of optical fibers. We present how these properties (electric modes, acoustic modes, and material properties) could be utilized to suppress SBS. The fiber-based techniques are divided into transverse optical fiber design, longitudinal variant fiber design, and external perturbations (strain and temperature) on optical fibers. Transverse optical fiber design focuses on the mechanism electro-acoustic interaction. Large effective area fiber design and acoustic tailoring techniques have been discussed. Longitudinal variant fiber design considers the nonlinear SBS interaction along propagation distance, and various techniques related have been presented. External perturbations (strain and temperature) on optical fibers emphasize on how external static perturbations could modify the SBS effect.},
  langid = {english},
  keywords = {fiber amplifiers,high-power fiber lasers,optical fiber,passive optical networks,stimulated Brillouin scattering},
  file = {/Users/jensen/Zotero/storage/X9J6Y592/Huang et al. - 2023 - Fiber-based techniques to suppress stimulated Brillouin scattering.pdf}
}

@standard{internationaltelecommunicationunionApplicationRelatedAspects2011,
  title = {Application Related Aspects of Optical Amplifier Devices and Sub-Systems ({{ITU-T Recommendation G}}.663)},
  author = {{International Telecommunication Union}},
  date = {2011-04-13T00:00:00+02:00},
  number = {G.663},
  location = {Geneva, Switzerland},
  url = {https://www.itu.int/epublications/publication/itu-t-g-663-2011-04-application-related-aspects-of-optical-amplifier-devices-and-subsystems},
  urldate = {2026-11-13},
  abstract = {This Recommendation defines applications, device types, operational considerations and transmission limits for optical amplifiers (OAs) used in optical systems. It classifies OAs as booster (BA), pre-amplifier (PA), line amplifier (LA), optically amplified transmitter (OAT) and receiver (OAR), and notes relevant system interfaces and parameter references (notably the ITU‑T G.690-series and G.662/G.661). BAs raise transmitter power but increase non-linear penalties; PAs improve receiver sensitivity and benefit from narrow-band filtering; LAs extend spans and require supervisory channels; OATs/OARs integrate amplifiers with transceivers. Single- and multi-channel, point-to-point and point-to-multipoint uses are covered; many multi-channel parameters remain under study. Environmental and optical safety requirements and APR procedures are referenced.Transmission-related impairments from increased launch power and long unregenerated spans are detailed: fibre non-linearities (SPM, IXPM/XPM, FWM/IFWM, MI, SBS, SRS), polarization effects (PMD, PDL, polarization hole burning), chromatic dispersion, and OA-specific issues (noise accumulation, self‑filtering, optical surge, SOA saturation-induced non-linearity). These impairments depend on fibre type, effective area, channel spacing, bit rate, modulation format and amplifier cascade.Mitigation strategies include fibre selection and dispersion management, appropriate channel spacing or uneven spacing, reduced launch power, increased effective area, narrow-band ASE filtering or self‑filtering, polarization scrambling and dynamic PMD compensation, ASE-filtering and per-channel equalization, gain-clamping or operating SOAs in linear regime, and pump control/APR to prevent optical surge. Appendix I gives example BA/PA parameter values; OAM items and alarms for OAs are specified.},
  langid = {english},
  file = {/Users/jensen/Zotero/storage/QE3LT8AV/itu-t-g-663-2011-04-application-related-aspects-of-optical-amplifier-devices-and-subsystems.html}
}

