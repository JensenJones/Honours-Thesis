@article{baiStimulatedBrillouinScattering2018,
  title = {Stimulated {{Brillouin}} Scattering Materials, Experimental Design and Applications: {{A}} Review},
  shorttitle = {Stimulated {{Brillouin}} Scattering Materials, Experimental Design and Applications},
  author = {Bai, Zhenxu and Yuan, Hang and Liu, Zhaohong and Xu, Pengbai and Gao, Qilin and Williams, Robert J. and Kitzler, Ondrej and Mildren, Richard P. and Wang, Yulei and Lu, Zhiwei},
