{
  "version": 1,
  "configurations": [
    {
      "name": "Build thesis",
      "command": [
        "latexmk"
      ]
    },
    {
      "name": "Watch thesis (rebuild on save)",
      "command": [
        "latexmk",
        "-pvc",
        "-view=none"
      ]
    },
    {
      "name": "Open PDF",
      "command": [
        "open",
        "build/main.pdf"
      ]
    },
    {
      "name": "Clean build files",
      "command": [
        "latexmk",
        "-c"
      ]
    },
    {
      "name": "build latex stuff",
      "commands": [
        "latexmk -pdf main.tex",
        "echo \"YO THIS BE MY CUSTOM ONE\""
      ]
    },
    {
      "name": "Jensen",
      "commands": [
        "latexmk"
      ]
    }
  ]
}
